# Runtime environment: development or production
FLASK_ENV=development

# Set a long, random value in production. Never commit the real value.
SECRET_KEY=

# Single-admin dashboard credentials. Store only a password hash.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Lifetime of the bearer token the Wix backend receives, in seconds.
ADMIN_TOKEN_MAX_AGE_SECONDS=1800

# SQLite file path. A persistent disk path should be used on Render.
DATABASE_URL=instance/yosuun.sqlite3

# Groq credentials stay on the backend. Empty means demo mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_HISTORY_MAX_MESSAGES=20
AI_HISTORY_MAX_CHARS=8000
AI_TEMPERATURE=0.3
AI_MAX_COMPLETION_TOKENS=500
KNOWLEDGE_BASE_PATH=knowledge/yosuun_mvp.md

# Public chat abuse protection. This limiter is process-local.
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Public lead form abuse protection. This limiter is process-local.
LEAD_RATE_LIMIT_REQUESTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600

# Shared with the Wix backend (Secrets Manager). When set, Wix requests are
# rate limited per visitor (X-Client-Id) instead of sharing Wix's IP.
# Empty means every request is limited by IP.
WIX_SHARED_SECRET=
# Total chat requests per window across all Wix visitors.
WIX_CHAT_RATE_LIMIT_REQUESTS=60

# Maximum accepted HTTP request body size in bytes.
MAX_CONTENT_LENGTH=65536
